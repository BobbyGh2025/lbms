// ============================================================================
// Lightworld Business Management System (LBMS) - Prisma Schema
// Phase 1: Foundation (Auth, RBAC, Org Structure, Settings, Audit, Notifications)
// ----------------------------------------------------------------------------
// NOTE: This project uses SQLite (per environment constraints). All "enum-like"
// fields are stored as String and validated at the application layer. Money
// values will be stored as Decimal in later phases once a MySQL-compatible
// datasource is available; for Phase 1 foundation tables no money fields
// are required.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================================
// AUTHENTICATION & USERS
// ============================================================================

model User {
  id                  String   @id @default(cuid())
  email               String   @unique
  username            String   @unique
  passwordHash        String
  employeeId          String?  @unique
  employee            Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  status              String   @default("active") // active | inactive | suspended
  lastLoginAt         DateTime?
  lastLoginIp         String?
  failedLoginAttempts Int      @default(0)
  lockedUntil         DateTime?
  mustChangePassword Boolean  @default(false)
  createdById         String?
  createdBy           User?    @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  usersCreated        User[]   @relation("UserCreatedBy")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?

  userRoles     UserRole[]
  auditLogs     AuditLog[]
  notifications Notification[]

  // Phase 2 finance back-relations
  finAccountsCreated  FinancialAccount[] @relation("FinAccountCreatedBy")
  ledgerAccountsCreated LedgerAccount[]  @relation("LedgerAccountCreatedBy")
  journalsCreated     Journal[]          @relation("JournalCreatedBy")
  journalsVoided     Journal[]          @relation("JournalVoidedBy")

  // Phase 3 HR back-relations
  leaveRequested  LeaveRequest[] @relation("LeaveRequestedBy")
  leaveApproved   LeaveRequest[] @relation("LeaveApprovedBy")

  // Phase 6 operations back-relations
  tasksCreated    Task[]          @relation("TaskCreator")

  // Phase 7 procurement back-relations
  procurementRequestsCreated  ProcurementRequest[] @relation("ProcurementRequestCreator")
  procurementRequestsUpdated  ProcurementRequest[] @relation("ProcurementRequestUpdater")
  procurementRequestsApproved ProcurementRequest[] @relation("ProcurementRequestApprover")
  purchaseOrdersRequested   PurchaseOrder[]   @relation("PurchaseOrderRequester")
  purchaseOrdersCreated   PurchaseOrder[]   @relation("PurchaseOrderCreator")
  purchaseOrdersUpdated   PurchaseOrder[]   @relation("PurchaseOrderUpdater")
  purchaseOrdersApproved PurchaseOrder[]   @relation("PurchaseOrderApprover")
  receiptsRecordedBy     GoodsReceipt[]    @relation("GoodsReceiptReceiver")

  // Phase 8 inventory back-relations
  inventoryCategoriesCreated InventoryCategory[] @relation("InventoryCategoryCreator")
  inventoryItemsCreated  InventoryItem[]   @relation("InventoryItemCreator")
  inventoryItemsUpdated  InventoryItem[]   @relation("InventoryItemUpdater")
  warehousesCreated      Warehouse[]       @relation("WarehouseCreator")
  warehousesUpdated      Warehouse[]       @relation("WarehouseUpdater")
  stockMovementsPerformed StockMovement[]  @relation("StockMovementPerformer")

  // Phase 10 sales back-relations
  quotesCreated          Quote[]           @relation("QuoteCreator")
  quotesUpdated          Quote[]           @relation("QuoteUpdater")
  quotesAccepted        Quote[]           @relation("QuoteAccepter")
  salesOrdersCreated     SalesOrder[]      @relation("SalesOrderCreator")
  salesOrdersUpdated     SalesOrder[]      @relation("SalesOrderUpdater")
  invoicesCreated        Invoice[]         @relation("InvoiceCreator")
  invoicesUpdated        Invoice[]         @relation("InvoiceUpdater")
  paymentsCreated        CustomerPayment[] @relation("PaymentCreator")
  paymentsVoidedBy       CustomerPayment[] @relation("PaymentVoidedBy")

  // Phase 11 AP/expense back-relations
  supplierBillsCreated     SupplierBill[]    @relation("SupplierBillCreator")
  supplierBillsUpdated     SupplierBill[]    @relation("SupplierBillUpdater")
  supplierBillsApproved   SupplierBill[]    @relation("SupplierBillApprover")
  supplierPaymentsCreated SupplierPayment[] @relation("SupplierPaymentCreator")
  supplierPaymentsVoidedBy SupplierPayment[] @relation("SupplierPaymentVoidedBy")
  expensesCreated         Expense[]         @relation("ExpenseCreator")
  expensesApproved        Expense[]         @relation("ExpenseApprover")

  @@index([status])
  @@index([createdById])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  description String?
  isSystem    Boolean  @default(false) // system roles cannot be deleted
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  permissions RolePermission[]
  users      UserRole[]
}

model Permission {
  id          String @id @default(cuid())
  module      String // e.g. "finance", "staff", "projects", "users", "settings"
  action      String // view | create | edit | delete | approve | export
  description String?

  roles RolePermission[]

  @@unique([module, action])
  @@index([module])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  assignedAt   DateTime   @default(now())
  assignedById String?

  @@id([roleId, permissionId])
}

model UserRole {
  userId      String
  roleId      String
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt  DateTime @default(now())
  assignedById String?

  @@id([userId, roleId])
}

// ============================================================================
// ORGANISATION STRUCTURE (configurable - never hard-coded)
// ============================================================================

model Department {
  id              String   @id @default(cuid())
  name            String   @unique
  code            String?  @unique
  description     String?
  headEmployeeId  String?
  headEmployee    Employee? @relation("DepartmentHead", fields: [headEmployeeId], references: [id], onDelete: SetNull)
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  employees Employee[]
  positions Position[]
  journals  Journal[] // Phase 2 finance back-relation
}

model Position {
  id              String    @id @default(cuid())
  title           String    @unique
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  description     String?
  responsibilities String?
  status          String    @default("active")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  employees Employee[]
}

model Employee {
  id              String   @id @default(cuid())
  employeeId      String   @unique // human-readable e.g. LT-EMP-0001 (legacy seed format)
  employeeNumber  String?  @unique // Phase 3 format: EMP-2026-000001 (nullable for legacy)

  // Identity
  fullName        String   // kept for backward compatibility; derived from firstName + lastName
  firstName       String?
  middleName      String?
  lastName        String?
  preferredName   String?
  profilePhotoUrl String?
  dateOfBirth     DateTime?
  gender          String?  // male | female | other

  // Contact
  phone           String?
  email           String?  @unique
  alternativePhone String?
  address         String?
  city            String?
  workLocation    String?

  // Employment
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  positionId      String?
  position        Position?   @relation(fields: [positionId], references: [id], onDelete: SetNull)
  employmentDate  DateTime?
  confirmationDate DateTime?
  endDate         DateTime?
  employmentType  String?  // full_time | part_time | contract | temporary | intern | consultant
  status          String   @default("active") // active | probation | on_leave | suspended | resigned | terminated | retired | inactive
  notes           String?

  // Reporting structure — self-relation for manager hierarchy
  managerId       String?
  manager         Employee? @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports   Employee[] @relation("EmployeeManager")
  departmentsHeaded Department[] @relation("DepartmentHead")

  // Administrative
  createdById     String?
  updatedById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  user               User?
  emergencyContacts  EmployeeEmergencyContact[]
  leaveRequests      LeaveRequest[]
  performanceReviews EmployeePerformanceReview[]

  // Phase 4 relationship back-relations
  customerAccountManager Customer[] @relation("CustomerAccountManager")
  supplierAccountManager Supplier[] @relation("SupplierAccountManager")
  activitiesAssigned    Activity[] @relation("ActivityAssignedTo")

  // Phase 5 project back-relations
  projectsManaged    Project[]            @relation("ProjectManager")
  projectTeamMembers ProjectTeamMember[]

  // Phase 6 operations back-relations
  assignedTasks      Task[]               @relation("TaskAssignee")

  // Phase 7 procurement back-relations
  procurementRequests ProcurementRequest[] @relation("ProcurementRequestRequester")

  // Phase 8 inventory back-relation
  stockIssueRequests  StockMovement[]     @relation("StockMovementEmployeeRequester")

  // Phase 11 expense back-relation
  expensesRequested   Expense[]           @relation("ExpenseEmployee")

  @@index([departmentId])
  @@index([status])
  @@index([managerId])
  @@index([employmentType])
}

// ============================================================================
// PHASE 3 — STAFF & HR MANAGEMENT
// ============================================================================

// Concurrency-safe employee number counter (separate from finance refs).
model EmployeeRefCounter {
  id        String   @id @default(cuid())
  prefix    String   @default("EMP")
  year      Int
  nextNumber Int     @default(1)

  @@unique([prefix, year])
}

model EmployeeEmergencyContact {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name        String
  relationship String?
  phone       String
  alternativePhone String?
  address     String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId])
}

// Leave types are configurable (not hard-coded enum).
model LeaveType {
  id          String   @id @default(cuid())
  name        String   @unique // e.g. Annual, Sick, Maternity, Compassionate, Study, Unpaid
  code        String   @unique // e.g. ANNUAL, SICK, MATERNITY
  description String?
  isPaid      Boolean  @default(true)
  isSystem    Boolean  @default(false) // system types seeded; cannot be deleted
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leaveRequests LeaveRequest[]
}

model LeaveRequest {
  id          String   @id @default(cuid())
  reference   String   @unique // e.g. LEV-2026-000001
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  startDate   DateTime
  endDate     DateTime
  reason      String?
  status      String   @default("pending") // pending | approved | rejected | cancelled
  attachmentUrl String?

  // Approval workflow
  requestedById   String
  requestedBy     User?    @relation("LeaveRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedById   String?
  approvedAt     DateTime?
  rejectionReason String?
  approvedBy     User? @relation("LeaveApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId])
  @@index([leaveTypeId])
  @@index([status])
  @@index([startDate])
  @@index([reference])
}

// Lightweight performance review foundation.
model EmployeePerformanceReview {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewPeriod  String   // e.g. "2026-Q1", "2026-Annual"
  reviewDate    DateTime
  reviewerId    String
  rating        String?  // e.g. "exceeds", "meets", "below" (configurable text, not hard-coded enum)
  strengths     String?
  improvementAreas String?
  objectives    String?
  comments      String?
  status        String   @default("draft") // draft | completed
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([employeeId])
  @@index([reviewDate])
}

// ============================================================================
// PHASE 4 — CUSTOMERS, SUPPLIERS & RELATIONSHIP MANAGEMENT
// ----------------------------------------------------------------------------
// Master data entities for organizations/individuals Lightworld Tech does
// business with. Customer = buys from us; Supplier = sells to us.
// Both are master data (NOT accounting entities). The Finance Journal has
// nullable partyType/partyRef string stubs from Phase 2 that will connect
// to these entities via the customerId/supplierId FKs on Journal.
// ============================================================================

// Concurrency-safe reference counter for customer/supplier numbers.
// Separate from FinanceRefCounter and EmployeeRefCounter.
model RelationshipRefCounter {
  id        String   @id @default(cuid())
  prefix    String   // CUS | SUP
  year      Int
  nextNumber Int     @default(1)

  @@unique([prefix, year])
}

model Customer {
  id              String   @id @default(cuid())
  customerNumber  String   @unique // CUS-2026-000001
  customerType    String   @default("business") // individual | business | organization | government | ngo | other
  legalName       String?
  tradingName     String?  // display name (may differ from legal name)
  firstName       String?  // for individual type
  lastName        String?  // for individual type
  email           String?
  phone           String?
  alternativePhone String?
  website         String?
  address         String?
  city            String?
  region          String?
  country         String   @default("Ghana")
  industry        String?
  contactPerson   String?  // primary contact name (quick reference)
  accountManagerId String? // Employee FK
  accountManager  Employee? @relation("CustomerAccountManager", fields: [accountManagerId], references: [id], onDelete: SetNull)
  status          String   @default("active") // active | inactive | prospect | suspended | archived
  customerSince   DateTime?
  notes           String?
  createdById     String?
  updatedById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime? // soft-delete (archive)

  contacts   CustomerContact[]
  activities Activity[] @relation("ActivityCustomer")
  journals   Journal[]  @relation("JournalCustomer")
  projects   Project[]  @relation("CustomerProjects")
  tasks      Task[]     @relation("CustomerTasks")

  // Phase 10 sales back-relations
  quotes        Quote[]
  salesOrders   SalesOrder[]
  invoices      Invoice[]
  payments      CustomerPayment[]

  @@index([status])
  @@index([customerType])
  @@index([accountManagerId])
  @@index([tradingName])
}

model CustomerContact {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String?
  jobTitle    String?
  email       String?
  phone       String?
  alternativePhone String?
  preferredContactMethod String? // email | phone | sms | other
  isPrimary   Boolean  @default(false)
  notes       String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([customerId])
}

model Supplier {
  id              String   @id @default(cuid())
  supplierNumber  String   @unique // SUP-2026-000001
  supplierType    String   @default("business") // business | individual | contractor | service_provider | government | other
  legalName       String?
  tradingName     String?
  email           String?
  phone           String?
  alternativePhone String?
  website         String?
  address         String?
  city            String?
  region          String?
  country         String   @default("Ghana")
  industry        String?  // category of goods/services
  contactPerson   String?
  accountManagerId String?
  accountManager  Employee? @relation("SupplierAccountManager", fields: [accountManagerId], references: [id], onDelete: SetNull)
  status          String   @default("active") // active | inactive | suspended | archived
  supplierSince   DateTime?
  notes           String?
  createdById     String?
  updatedById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  contacts   SupplierContact[]
  activities Activity[] @relation("ActivitySupplier")
  journals   Journal[]  @relation("JournalSupplier")

  // Phase 7 procurement back-relations
  procurementRequests ProcurementRequest[] @relation("ProcurementRequestSupplier")
  purchaseOrders      PurchaseOrder[]      @relation("PurchaseOrderSupplier")
  goodsReceipts       GoodsReceipt[]       @relation("GoodsReceiptSupplier")

  // Phase 8 inventory back-relation
  stockMovements      StockMovement[]      @relation("StockMovementSupplier")

  // Phase 11 AP back-relations
  supplierBills       SupplierBill[]
  supplierPayments    SupplierPayment[]
  expenses            Expense[]

  @@index([status])
  @@index([supplierType])
  @@index([accountManagerId])
  @@index([tradingName])
}

model SupplierContact {
  id          String   @id @default(cuid())
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String?
  jobTitle    String?
  email       String?
  phone       String?
  alternativePhone String?
  preferredContactMethod String?
  isPrimary   Boolean  @default(false)
  notes       String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([supplierId])
}

// Lightweight CRM activity / follow-up foundation.
model Activity {
  id          String   @id @default(cuid())
  activityType String  // call | meeting | email | follow_up | site_visit | note | quotation | other
  subject     String
  description String?
  customerId  String?
  customer    Customer? @relation("ActivityCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  supplierId  String?
  supplier    Supplier? @relation("ActivitySupplier", fields: [supplierId], references: [id], onDelete: SetNull)
  projectId   String?
  project     Project?  @relation("ActivityProject", fields: [projectId], references: [id], onDelete: SetNull)
  assignedToId String?  // Employee FK
  assignedTo  Employee? @relation("ActivityAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  dueDate     DateTime?
  completedDate DateTime?
  status      String   @default("open") // open | completed | cancelled | overdue
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([customerId])
  @@index([supplierId])
  @@index([projectId])
  @@index([assignedToId])
  @@index([status])
  @@index([dueDate])
}

// ============================================================================
// PHASE 5 — PROJECT MANAGEMENT & PROJECT PROFITABILITY FOUNDATION
// ----------------------------------------------------------------------------
// Project is the authoritative operational entity for company projects.
// It integrates with Customer (Phase 4), Employee (Phase 3), and Finance
// (Phase 2) via the Journal.projectId FK. Financial data is NEVER duplicated —
// project financial metrics derive from the authoritative Finance ledger.
// ============================================================================

// Concurrency-safe project number counter (separate from all other counters).
model ProjectRefCounter {
  id        String   @id @default(cuid())
  prefix    String   @default("PRJ")
  year      Int
  nextNumber Int     @default(1)

  @@unique([prefix, year])
}

model Project {
  id              String   @id @default(cuid())
  projectNumber   String   @unique // PRJ-2026-000001
  name            String
  description     String?
  customerId      String?  // optional — some projects may be internal
  customer        Customer? @relation("CustomerProjects", fields: [customerId], references: [id], onDelete: SetNull)
  projectManagerId String?
  projectManager  Employee? @relation("ProjectManager", fields: [projectManagerId], references: [id], onDelete: SetNull)
  status          String   @default("planning") // planning | active | on_hold | completed | cancelled
  priority        String   @default("medium") // low | medium | high | critical
  startDate       DateTime?
  plannedEndDate  DateTime?
  actualEndDate   DateTime?
  budgetAmount    Decimal  @default(0)
  estimatedRevenue Decimal @default(0)
  estimatedCost   Decimal  @default(0)
  notes           String?
  createdById     String?
  updatedById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime? // soft-delete (archive)

  teamMembers     ProjectTeamMember[]
  milestones      ProjectMilestone[]
  journals        Journal[] @relation("JournalProject")
  activities      Activity[] @relation("ActivityProject")
  tasks           Task[]    @relation("ProjectTasks")

  // Phase 7 procurement back-relations
  procurementRequests ProcurementRequest[] @relation("ProcurementRequestProject")
  purchaseOrders      PurchaseOrder[]      @relation("PurchaseOrderProject")

  // Phase 8 inventory back-relation
  stockMovements      StockMovement[]      @relation("StockMovementProject")

  // Phase 10 sales back-relations
  quotes        Quote[]
  salesOrders   SalesOrder[]
  invoices      Invoice[]

  // Phase 11 AP back-relations
  supplierBills  SupplierBill[]
  expenses       Expense[]

  @@index([status])
  @@index([customerId])
  @@index([projectManagerId])
  @@index([priority])
}

model ProjectTeamMember {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role        String?  // e.g. "Developer", "Designer", "QA"
  assignedAt  DateTime @default(now())
  removedAt   DateTime?
  status      String   @default("active") // active | inactive

  @@unique([projectId, employeeId])
  @@index([projectId])
  @@index([employeeId])
}

model ProjectMilestone {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  dueDate     DateTime?
  completedDate DateTime?
  status      String   @default("pending") // pending | completed | cancelled
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([dueDate])
}

// ============================================================================
// PHASE 6 — OPERATIONS & WORKFLOW FOUNDATION
// ----------------------------------------------------------------------------
// Task is the authoritative operational work entity. It integrates with
// Project (Phase 5), Customer (Phase 4), and Employee (Phase 3). Operational
// tasks are NOT accounting entries — they track work execution, deadlines,
// and assignments. Financial integration happens via the Finance posting engine.
// ============================================================================

// Concurrency-safe task number counter (separate from all other counters).
model TaskRefCounter {
  id        String   @id @default(cuid())
  prefix    String   @default("TSK")
  year      Int
  nextNumber Int     @default(1)

  @@unique([prefix, year])
}

model Task {
  id              String   @id @default(cuid())
  taskNumber      String   @unique // TSK-2026-000001
  title           String
  description     String?
  projectId       String?
  project         Project? @relation("ProjectTasks", fields: [projectId], references: [id], onDelete: SetNull)
  customerId      String?  // optional — may be derived from project
  customer        Customer? @relation("CustomerTasks", fields: [customerId], references: [id], onDelete: SetNull)
  assignedEmployeeId String?
  assignedEmployee Employee? @relation("TaskAssignee", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  createdById     String?
  createdBy       User?    @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  status          String   @default("todo") // todo | in_progress | on_hold | completed | cancelled
  priority        String   @default("medium") // low | medium | high | critical
  dueDate         DateTime?
  startDate       DateTime?
  completedDate   DateTime?
  estimatedHours  Decimal  @default(0)
  actualHours     Decimal  @default(0)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime? // soft-delete

  checklists      TaskChecklist[]

  // Phase 7 procurement back-relation
  procurementRequests ProcurementRequest[] @relation("ProcurementRequestTask")

  // Phase 8 inventory back-relation
  stockMovements      StockMovement[]      @relation("StockMovementTask")

  @@index([projectId])
  @@index([customerId])
  @@index([assignedEmployeeId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
}

model TaskChecklist {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      String   @default("active") // active | completed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       TaskChecklistItem[]

  @@index([taskId])
}

model TaskChecklistItem {
  id          String   @id @default(cuid())
  checklistId String
  checklist   TaskChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  description String
  isCompleted Boolean  @default(false)
  completedAt DateTime?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([checklistId])
}

// ============================================================================
// COMPANY SETTINGS (single-row configuration table)
// ============================================================================

model CompanySetting {
  id                  String   @id @default("singleton")
  companyName         String   @default("Lightworld Tech")
  legalName           String?
  logoUrl             String?
  address             String?
  city                String?
  region              String?
  country             String   @default("Ghana")
  phone               String?
  email               String?
  website             String?
  currency            String   @default("GHS")
  currencySymbol      String   @default("GH\u20B5")
  financialYearStart  String?  // e.g. "01-01" (MM-DD)
  invoicePrefix       String   @default("INV-")
  invoiceStart        Int      @default(1)
  taxIdNumber         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ============================================================================
// AUDIT TRAIL (immutable record of important actions)
// ============================================================================

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action        String   // login | logout | create | update | delete | approve | reject | view_sensitive
  module        String   // auth | users | roles | settings | departments | positions | employees
  recordId      String?
  recordType    String?
  description   String?
  ipAddress     String?
  userAgent     String?
  previousValue String?  // JSON string of previous state
  newValue      String?  // JSON string of new state
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([module])
  @@index([createdAt])
}

// ============================================================================
// NOTIFICATIONS & REMINDERS
// ============================================================================

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String    @default("info") // info | warning | error | success
  category  String?   // approval | task | invoice | payment | deadline | system | etc
  linkUrl   String?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

// ============================================================================
// PHASE 2 — FINANCE FOUNDATION
// ----------------------------------------------------------------------------
// Journal/ledger double-entry architecture. Money uses Prisma `Decimal`
// (stored as TEXT in SQLite for dev; migrates to DECIMAL(18,2) on
// PostgreSQL/MySQL with zero schema change). Balances are DERIVED from
// posted JournalEntries — there is no mutable `currentBalance` field.
//
//   FinancialAccount  (where money lives: cash/bank/momo)
//          ↓
//   LedgerAccount      (chart of accounts: income/expense/asset categories)
//          ↓
//   Journal            (one financial event; header)
//          ↓
//   JournalEntry       (debit/credit lines; MUST balance: Σ debit = Σ credit)
//          ↓
//   Reporting Service  (single source of truth for balances/summaries)
//          ↓
//   Dashboard / Reports / Exports
// ============================================================================

// Account types classify the nature of a financial account.
//   asset      — cash, bank, mobile money (debit-normal: debits increase)
//   liability  — payables, loans (credit-normal: credits increase)
//   equity     — owner's equity, retained earnings (credit-normal)
//   income     — revenue categories (credit-normal)
//   expense    — expense categories (debit-normal)

model FinancialAccount {
  id            String   @id @default(cuid())
  code          String   @unique // e.g. "CASH-001", "BANK-001"
  name          String   @unique
  accountType   String   @default("asset") // asset | liability (financial accounts are typically asset accounts that hold money)
  currency      String   @default("GHS")
  // Opening balance is posted via an OPENING_BALANCE journal — NOT a mutable
  // live field. `openingBalance` is the seed value used to generate that
  // journal at account creation. It is never updated by transactions.
  openingBalance Decimal @default(0)
  status        String   @default("active") // active | inactive
  description   String?
  bankName      String?
  accountNumber String?  // masked/reference only
  createdById   String?
  createdBy     User?    @relation("FinAccountCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  journalEntries JournalEntry[]
  journals       Journal[] // journals where this is the primary financial account

  @@index([status])
  @@index([currency])
}

// Chart of accounts — categorizes the nature of money movement.
// One LedgerAccount per income/expense/asset/liability/equity category.
model LedgerAccount {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. "INC-SALES", "EXP-FUEL"
  name        String   @unique
  accountClass String  // asset | liability | equity | income | expense
  accountType String   // e.g. "income", "expense", "asset", "liability", "equity"
  currency    String   @default("GHS")
  status      String   @default("active")
  description String?
  isSystem    Boolean  @default(false) // system categories seeded; can be deactivated but not deleted
  createdById String?
  createdBy   User?    @relation("LedgerAccountCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  journals      Journal[]
  journalEntries JournalEntry[]

  @@index([accountClass])
  @@index([accountType])
  @@index([status])
}

// A Journal is ONE financial event (an income receipt, an expense payment,
// a transfer, an opening balance, or an adjustment). It owns ≥2 JournalEntry
// lines that must balance: Σ(debit) = Σ(credit).
model Journal {
  id              String   @id @default(cuid())
  reference       String   @unique // e.g. "INC-2026-000001" — concurrency-safe, generated in-transaction
  transactionType String   // income | expense | transfer | opening_balance | adjustment
  status          String   @default("posted") // draft | posted | voided | reversed
  transactionDate DateTime // the accounting date (NOT createdAt — may differ)
  description     String?
  notes           String?

  // The financial account primarily affected (receiving account for income,
  // paying account for expense, source for transfer). For multi-account
  // journals (transfers), the full debit/credit breakdown is in JournalEntry.
  financialAccountId String?
  financialAccount   FinancialAccount? @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)

  // The primary ledger category (income/expense category). Full breakdown
  // is in JournalEntry.
  ledgerAccountId String?
  ledgerAccount   LedgerAccount? @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)

  // Optional relations — wired to Phase 5/6 entities when they land.
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  // Party reference (customer/supplier) — nullable stub from Phase 2.
  // `partyType` discriminates; `partyRef` holds the entity ID as a string.
  // Phase 4 adds proper FK relations (customerId/supplierId) below.
  partyType String? // customer | supplier | null
  partyRef  String? // future FK to Customer/Supplier

  // Phase 4: proper Customer/Supplier FK relations (nullable, alongside the
  // string stubs for backward compatibility with existing journals).
  customerId String?
  customer   Customer? @relation("JournalCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  supplierId String?
  supplier   Supplier? @relation("JournalSupplier", fields: [supplierId], references: [id], onDelete: SetNull)

  // Project reference — legacy string stub from Phase 2.
  // Phase 5 adds proper projectId FK below.
  projectRef String?

  // Phase 5: proper Project FK relation (nullable, alongside legacy stub).
  projectId String?
  project   Project? @relation("JournalProject", fields: [projectId], references: [id], onDelete: SetNull)

  paymentMethod String? // cash | bank_transfer | mobile_money | card | cheque | other
  externalRef  String? // bank slip / cheque / momo transaction id

  // Reversal linkage. `reversesId` is the FK on the reversal journal pointing
  // to the original. `reverses` is the relation (holds fields). `reversedBy`
  // is the inverse relation on the original journal (no fields).
  reversesId      String?  @unique
  reverses        Journal?  @relation("JournalReversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversedBy     Journal?  @relation("JournalReversal")
  reversalReason String?

  // Total monetary value of the transaction (the absolute amount; equals
  // Σ(debit) = Σ(credit)). Stored as Decimal for exact precision.
  amount      Decimal
  currency    String  @default("GHS")

  createdById String
  createdBy   User    @relation("JournalCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  postedAt    DateTime?
  voidedAt    DateTime?
  voidedById  String?
  voidedBy    User?   @relation("JournalVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entries JournalEntry[]

  @@index([transactionType])
  @@index([status])
  @@index([transactionDate])
  @@index([financialAccountId])
  @@index([ledgerAccountId])
  @@index([departmentId])
  @@index([createdById])
  @@index([reference])
  @@index([customerId])
  @@index([supplierId])
  @@index([projectId])
}

// A single debit OR credit line within a Journal. Exactly one of
// (debit, credit) is non-zero per entry. The journal is balanced when
// Σ(debit) = Σ(credit) across all its entries.
//
// `financialAccountId` is OPTIONAL: only entries that move money in/out of
// a cash/bank/momo account reference a FinancialAccount. The counter-side
// (e.g. an income category credit, or an expense category debit) references
// only a LedgerAccount. This mirrors real accounting where income/expense
// categories are not "accounts you hold money in".
model JournalEntry {
  id                String   @id @default(cuid())
  journalId         String
  journal           Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)

  financialAccountId String?
  financialAccount   FinancialAccount? @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)

  ledgerAccountId   String?
  ledgerAccount     LedgerAccount? @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)

  // Exactly one of debit/credit is non-zero (the other is 0). Both Decimal.
  debit  Decimal @default(0)
  credit Decimal @default(0)
  currency String @default("GHS")

  description String?
  createdAt   DateTime @default(now())

  @@index([journalId])
  @@index([financialAccountId])
  @@index([ledgerAccountId])
}

// Concurrency-safe reference counter. Each (prefix, year) gets a row;
// the posting engine increments `nextNumber` inside a db.$transaction
// to guarantee uniqueness even under concurrent inserts.
model FinanceRefCounter {
  id        String   @id @default(cuid())
  prefix    String   // INC | EXP | TRF | OPB | ADJ
  year      Int
  nextNumber Int     @default(1)

  @@unique([prefix, year])
}

// Idempotency log — optional. If a client sends an `Idempotency-Key`
// header, the server records the request; a replay returns the cached
// response instead of creating a duplicate transaction.
// ============================================================================
// PHASE 7 — PROCUREMENT, SUPPLIER OPERATIONS & RESOURCE MANAGEMENT FOUNDATION
// ----------------------------------------------------------------------------
// Procurement connects operational/project requirements to suppliers. The
// flow is: ProcurementRequest (internal need) → approval → PurchaseOrder
// (external commitment to a supplier) → receiving (goods/services arrive).
//
// FINANCE BOUNDARY (critical):
//   Procurement does NOT create journals or AP entries. The Finance posting
//   engine (src/lib/finance/posting-engine.ts) remains the single authoritative
//   financial poster. The handoff from an approved PO to a supplier bill/AP
//   is DEFERRED to a future phase that implements proper accounts-payable.
//   For now, PurchaseOrder totals are *commitments* (not posted liabilities).
// ============================================================================

// Concurrency-safe procurement counter. Prefix "REQ" → procurement requests,
// prefix "PO" → purchase orders. Separate from all other ref counters.
model ProcurementRefCounter {
  id        String   @id @default(cuid())
  prefix    String   // REQ | PO
  year      Int
  nextNumber Int     @default(1)

  @@unique([prefix, year])
}

/**
 * Procurement Request (internal requisition). Expresses an operational need
 * for goods/services, optionally linked to a project, task and/or supplier.
 * Lifecycle: DRAFT → SUBMITTED → APPROVED/REJECTED → CONVERTED/CANCELLED.
 */
model ProcurementRequest {
  id              String   @id @default(cuid())
  requestNumber   String   @unique // REQ-2026-000001
  title           String
  description     String?

  // Requester (employee who raised the request)
  requesterId     String
  requester       Employee @relation("ProcurementRequestRequester", fields: [requesterId], references: [id], onDelete: Restrict)

  // Optional project/task linkage
  projectId       String?
  project         Project?  @relation("ProcurementRequestProject", fields: [projectId], references: [id], onDelete: SetNull)
  taskId          String?
  task            Task?    @relation("ProcurementRequestTask", fields: [taskId], references: [id], onDelete: SetNull)

  // Preferred/suggested supplier (may be assigned at approval)
  supplierId      String?
  supplier        Supplier? @relation("ProcurementRequestSupplier", fields: [supplierId], references: [id], onDelete: SetNull)

  priority        String   @default("medium") // low | medium | high | critical
  requestedDate   DateTime @default(now())
  requiredByDate  DateTime?
  status          String   @default("draft") // draft | submitted | approved | rejected | converted | cancelled
  notes           String?

  // Approval trail
  submittedAt     DateTime?
  submittedById   String?
  approvedAt      DateTime?
  approvedById    String?
  approvedBy      User?    @relation("ProcurementRequestApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedAt      DateTime?
  rejectedById    String?
  rejectedReason  String?
  cancelledAt     DateTime?
  cancelledById   String?

  createdById     String?
  createdBy       User?    @relation("ProcurementRequestCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById     String?
  updatedBy       User?    @relation("ProcurementRequestUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime? // soft-delete

  // The purchase order created from this request (1:1, via the @unique
  // procurementRequestId on PurchaseOrder). Conversion timestamp is recorded
  // here; the PO back-relation is `convertedPurchaseOrder`.
  convertedAt     DateTime?

  // Back-relation to the single PO created from this request (if any).
  // The FK lives on PurchaseOrder.procurementRequestId (@unique).
  convertedPurchaseOrder PurchaseOrder? @relation("PurchaseOrderFromRequest")

  @@index([requesterId])
  @@index([projectId])
  @@index([taskId])
  @@index([supplierId])
  @@index([status])
  @@index([priority])
  @@index([requiredByDate])
}

/**
 * Purchase Order (external commitment to a supplier). Created from an
 * approved procurement request or independently. Contains line items.
 * Lifecycle: DRAFT → PENDING_APPROVAL → APPROVED → SENT → PARTIALLY_RECEIVED/
 * RECEIVED → CLOSED/CANCELLED.
 */
model PurchaseOrder {
  id                   String   @id @default(cuid())
  purchaseOrderNumber  String   @unique // PO-2026-000001

  supplierId           String
  supplier             Supplier @relation("PurchaseOrderSupplier", fields: [supplierId], references: [id], onDelete: Restrict)

  // Optional link to the originating procurement request (1:1 — a request
  // converts to exactly one PO).
  procurementRequestId String? @unique
  procurementRequest   ProcurementRequest? @relation("PurchaseOrderFromRequest", fields: [procurementRequestId], references: [id], onDelete: SetNull)

  // Optional project linkage (cost may be attributed to a project)
  projectId            String?
  project              Project? @relation("PurchaseOrderProject", fields: [projectId], references: [id], onDelete: SetNull)

  requestedById        String
  requestedBy          User     @relation("PurchaseOrderRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  approvedById         String?
  approvedBy           User?    @relation("PurchaseOrderApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt           DateTime?

  orderDate            DateTime @default(now())
  expectedDeliveryDate DateTime?
  sentAt               DateTime?
  closedAt             DateTime?
  cancelledAt          DateTime?
  cancelledById        String?

  status               String   @default("draft") // draft | pending_approval | approved | sent | partially_received | received | closed | cancelled
  notes                String?

  // Monetary totals — server-calculated from line items (never trusted from client)
  subtotal             Decimal  @default(0)
  tax                  Decimal  @default(0)
  total                Decimal  @default(0)
  currency             String   @default("GHS")

  createdById          String?
  createdBy            User?    @relation("PurchaseOrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById          String?
  updatedBy            User?    @relation("PurchaseOrderUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  deletedAt            DateTime? // soft-delete

  items                PurchaseOrderItem[]
  goodsReceipts        GoodsReceipt[]

  @@index([supplierId])
  @@index([projectId])
  @@index([procurementRequestId])
  @@index([requestedById])
  @@index([status])
  @@index([orderDate])
  @@index([expectedDeliveryDate])
}

/**
 * Purchase Order line item. Totals are server-calculated. Quantity uses
 * Decimal to support fractional quantities (e.g. 1.5 hours of service).
 */
model PurchaseOrderItem {
  id                String   @id @default(cuid())
  purchaseOrderId   String
  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  description       String
  quantity          Decimal  @default(0)
  unitPrice         Decimal  @default(0)
  taxRate           Decimal  @default(0) // percentage e.g. 0, 5, 15
  tax               Decimal  @default(0) // computed tax amount
  total             Decimal  @default(0) // quantity * unitPrice + tax

  receivedQuantity Decimal  @default(0) // running total of quantities received
  status            String   @default("pending") // pending | partially_received | received | cancelled

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  goodsReceiptItems GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@index([status])
}

/**
 * Goods Receipt — records a receiving event against a purchase order. One PO
 * may have multiple receipts (partial deliveries). Each receipt records who
 * received it, when, and per-item received quantities. Over-receipt is
 * rejected by the API (receivedQuantity would exceed orderedQuantity).
 */
model GoodsReceipt {
  id                String   @id @default(cuid())
  receiptNumber     String   @unique // GR-2026-000001
  purchaseOrderId   String
  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)

  supplierId        String
  supplier          Supplier @relation("GoodsReceiptSupplier", fields: [supplierId], references: [id], onDelete: Restrict)

  receivedById      String?
  receivedBy        User?    @relation("GoodsReceiptReceiver", fields: [receivedById], references: [id], onDelete: SetNull)

  receiptDate       DateTime @default(now())
  notes             String?
  status            String   @default("completed") // completed | voided

  createdById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  items             GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@index([supplierId])
  @@index([receiptDate])
}

/** Goods receipt line — captures per-item received quantity for this receipt. */
model GoodsReceiptItem {
  id                String   @id @default(cuid())
  goodsReceiptId    String
  goodsReceipt      GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String
  purchaseOrderItem  PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Cascade)
  receivedQuantity  Decimal  @default(0)
  notes             String?

  // Phase 8: marker to prevent double-posting into inventory. Once a goods
  // receipt item has been posted to inventory, this timestamp is set. Any
  // further posting attempt is rejected (the unique reference on StockMovement
  // also enforces this at the DB level).
  inventoryPostedAt DateTime?

  @@index([goodsReceiptId])
  @@index([purchaseOrderItemId])
}

model FinanceIdempotencyLog {
  id            String   @id @default(cuid())
  key           String   @unique
  userId        String
  responseHash  String
  responseBody  String
  statusCode    Int
  createdAt     DateTime @default(now())
  expiresAt     DateTime

  @@index([userId])
  @@index([expiresAt])
}

// ============================================================================
// PHASE 10 — SALES, QUOTATIONS, INVOICING & RECEIVABLES
// ----------------------------------------------------------------------------
// Sales flow: Quote → SalesOrder → Invoice → Payment → Finance posting
//
// FINANCE BOUNDARY: Invoices are commercial documents, NOT accounting entries.
// AR balance is tracked operationally (Invoice.total − Σ posted Payments).
// When a payment is received, the existing Finance posting engine is called
// (postIncome) to record the cash receipt + revenue recognition. No duplicate
// ledger is created.
//
// RECEIVABLES: balanceDue = invoice.total − Σ(posted payments for that invoice).
// Customer receivable balance = Σ(invoice.balanceDue) across all invoices.
// Overdue = dueDate < now AND balanceDue > 0 AND status != voided.
// ============================================================================

// Concurrency-safe sales document reference counter.
// Prefixes: QT (quote), SO (sales order), INV (invoice), PMT (payment).
model SalesRefCounter {
  id        String   @id @default(cuid())
  prefix    String   // QT | SO | INV | PMT
  year      Int
  nextNumber Int     @default(1)

  @@unique([prefix, year])
}

/**
 * Quotation — a commercial proposal to a customer. Lifecycle:
 * draft → sent → accepted → converted (to sales order)
 * Terminal: rejected, expired, cancelled.
 * Totals are server-calculated from line items. Client-supplied totals ignored.
 */
model Quote {
  id              String   @id @default(cuid())
  quoteNumber     String   @unique // QT-2026-000001
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  issueDate       DateTime @default(now())
  expiryDate      DateTime?
  status          String   @default("draft") // draft | sent | accepted | rejected | expired | converted | cancelled
  subtotal        Decimal  @default(0) // server-calculated
  discount        Decimal  @default(0) // flat discount amount
  tax             Decimal  @default(0) // server-calculated from line tax
  total           Decimal  @default(0) // server-calculated
  notes           String?
  terms           String?
  sentAt          DateTime?
  acceptedAt      DateTime?
  acceptedById    String?
  acceptedBy      User?    @relation("QuoteAccepter", fields: [acceptedById], references: [id], onDelete: SetNull)
  convertedAt     DateTime?
  convertedToSalesOrderId String? // FK to SalesOrder (set when converted)
  createdById     String?
  createdBy       User?    @relation("QuoteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById     String?
  updatedBy       User?    @relation("QuoteUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime? // soft-delete

  items           QuoteItem[]
  salesOrders     SalesOrder[] // quotes can be referenced by orders

  @@index([customerId])
  @@index([projectId])
  @@index([status])
  @@index([issueDate])
}

model QuoteItem {
  id              String   @id @default(cuid())
  quoteId         String
  quote           Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  description     String
  quantity        Decimal  @default(0)
  unitPrice       Decimal  @default(0)
  discount        Decimal  @default(0) // line discount (flat amount)
  taxRate         Decimal  @default(0) // percentage
  tax             Decimal  @default(0) // computed
  total           Decimal  @default(0) // computed: qty × price − discount + tax
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([quoteId])
  @@index([inventoryItemId])
}

/**
 * Sales Order — a confirmed customer order. Lifecycle:
 * draft → confirmed → processing → completed
 * Terminal: cancelled.
 */
model SalesOrder {
  id              String   @id @default(cuid())
  orderNumber     String   @unique // SO-2026-000001
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quoteId         String?
  quote           Quote?   @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  orderDate       DateTime @default(now())
  status          String   @default("draft") // draft | confirmed | processing | completed | cancelled
  subtotal        Decimal  @default(0)
  discount        Decimal  @default(0)
  tax             Decimal  @default(0)
  total           Decimal  @default(0)
  notes           String?
  confirmedAt     DateTime?
  confirmedById   String?
  createdById     String?
  createdBy       User?    @relation("SalesOrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById     String?
  updatedBy       User?    @relation("SalesOrderUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime? // soft-delete

  items           SalesOrderItem[]
  invoices        Invoice[] // an order can have multiple invoices (partial billing)

  @@index([customerId])
  @@index([quoteId])
  @@index([projectId])
  @@index([status])
  @@index([orderDate])
}

model SalesOrderItem {
  id              String   @id @default(cuid())
  salesOrderId    String
  salesOrder      SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  description     String
  quantity        Decimal  @default(0)
  unitPrice       Decimal  @default(0)
  discount        Decimal  @default(0)
  taxRate         Decimal  @default(0)
  tax             Decimal  @default(0)
  total           Decimal  @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([salesOrderId])
  @@index([inventoryItemId])
}

/**
 * Invoice — a commercial demand for payment. Lifecycle:
 * draft → issued → partially_paid → paid
 * Possible: voided. Overdue is DERIVED (dueDate < now AND balanceDue > 0 AND status != voided).
 * balanceDue = total − Σ(posted payments). NOT a client-supplied field.
 */
model Invoice {
  id              String   @id @default(cuid())
  invoiceNumber   String   @unique // INV-2026-000001
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesOrderId    String?
  salesOrder      SalesOrder? @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  issueDate       DateTime @default(now())
  dueDate         DateTime
  status          String   @default("draft") // draft | issued | partially_paid | paid | voided
  subtotal        Decimal  @default(0)
  discount        Decimal  @default(0)
  tax             Decimal  @default(0)
  total           Decimal  @default(0)
  amountPaid      Decimal  @default(0) // cached: Σ posted payments (recomputable from payments)
  balanceDue      Decimal  @default(0) // cached: total − amountPaid
  notes           String?
  terms           String?
  journalId       String?  // FK to the posted Journal (invoice issuance: Dr AR / Cr Revenue)
  issuedAt        DateTime?
  issuedById      String?
  voidedAt        DateTime?
  voidedById      String?
  createdById     String?
  createdBy       User?    @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById     String?
  updatedBy       User?    @relation("InvoiceUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime? // soft-delete

  items           InvoiceItem[]
  payments        CustomerPayment[]

  @@index([customerId])
  @@index([salesOrderId])
  @@index([projectId])
  @@index([status])
  @@index([issueDate])
  @@index([dueDate])
}

model InvoiceItem {
  id              String   @id @default(cuid())
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  description     String
  quantity        Decimal  @default(0)
  unitPrice       Decimal  @default(0)
  discount        Decimal  @default(0)
  taxRate         Decimal  @default(0)
  tax             Decimal  @default(0)
  total           Decimal  @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([invoiceId])
  @@index([inventoryItemId])
}

/**
 * Customer Payment — records a payment received against an invoice.
 * Lifecycle: draft → posted. Possible: voided.
 * When posted, the Finance posting engine is called (postIncome) to record
 * the cash receipt + revenue recognition. Voiding a posted payment creates a
 * reversal journal (via the posting engine's void mechanism).
 */
model CustomerPayment {
  id              String   @id @default(cuid())
  paymentNumber   String   @unique // PMT-2026-000001
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoiceId       String?
  invoice         Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  paymentDate     DateTime @default(now())
  amount          Decimal  @default(0)
  paymentMethod   String   @default("cash") // cash | bank_transfer | mobile_money | card | cheque | other
  reference       String? // bank slip / cheque / momo transaction id
  notes           String?
  status          String   @default("draft") // draft | posted | voided
  journalId       String?  // FK to the posted Journal (for void/reversal)
  postedAt        DateTime?
  voidedAt        DateTime?
  voidedById      String?
  voidedBy        User?    @relation("PaymentVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  createdById     String?
  createdBy       User?    @relation("PaymentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([customerId])
  @@index([invoiceId])
  @@index([status])
  @@index([paymentDate])
}

// ============================================================================
// PHASE 8 — INVENTORY & WAREHOUSE MANAGEMENT FOUNDATION
// ----------------------------------------------------------------------------
// Inventory becomes the authoritative operational record for stock AFTER goods
// are physically received. The flow is:
//
//   Procurement:  Request → PurchaseOrder → GoodsReceipt
//                                              ↓
//   Inventory:    StockReceipt (refs GoodsReceiptItem) → StockBalance → StockMovement ledger
//                 Issue / Transfer / Adjustment → StockMovement ledger
//
// FINANCE BOUNDARY (critical):
//   Inventory NEVER creates Journal/JournalEntry. The Finance posting engine
//   remains authoritative. Inventory valuation/accounting is deferred. PO
//   totals and stock quantities are operational, not accounting entries.
//
// DOUBLE-POSTING PREVENTION:
//   GoodsReceiptItem.inventoryPostedAt marker + StockMovement @@unique on
//   (referenceType, referenceId) — a single goods receipt item can produce
//   at most one inventory receipt movement.
// ============================================================================

// Concurrency-safe inventory reference counter. Prefixes: SRI (stock receipt),
// ISS (issue), TRF (transfer), ADJ (adjustment). Separate from all other counters.
model InventoryRefCounter {
  id        String   @id @default(cuid())
  prefix    String   // SRI | ISS | TRF | ADJ
  year      Int
  nextNumber Int     @default(1)

  @@unique([prefix, year])
}

/**
 * Inventory Category — lightweight grouping for inventory items (not a full
 * product catalog). Prevents duplicate category names.
 */
model InventoryCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  active      Boolean  @default(true)
  createdById String?
  createdBy   User?    @relation("InventoryCategoryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       InventoryItem[]

  @@index([active])
}

/**
 * Inventory Item — the authoritative stock-item identity. Identified by a
 * unique itemCode (SKU). Quantities use Decimal (fractional quantities valid).
 * Soft-deleted via deletedAt; deactivated via active=false.
 */
model InventoryItem {
  id              String   @id @default(cuid())
  itemCode        String   @unique // SKU e.g. "CEM-50KG"
  name            String
  description     String?
  categoryId      String?
  category        InventoryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unitOfMeasure   String   @default("unit") // kg | litre | metre | box | unit | etc
  reorderLevel    Decimal  @default(0) // trigger reorder when stock falls below this
  reorderQuantity Decimal  @default(0) // suggested reorder quantity
  active          Boolean  @default(true)
  createdById     String?
  createdBy       User?    @relation("InventoryItemCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById     String?
  updatedBy       User?    @relation("InventoryItemUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime? // soft-delete

  stockBalances   StockBalance[]
  movements       StockMovement[]

  // Phase 10 sales back-relations (optional item linkage on sales documents)
  quoteItems      QuoteItem[]
  salesOrderItems SalesOrderItem[]
  invoiceItems    InvoiceItem[]

  // Phase 11 AP back-relation
  supplierBillItems SupplierBillItem[]

  @@index([categoryId])
  @@index([active])
  @@index([name])
}

/**
 * Warehouse — a physical storage location. Identified by a unique code.
 */
model Warehouse {
  id              String   @id @default(cuid())
  code            String   @unique // e.g. "WH-MAIN", "WH-BRANCH-01"
  name            String
  description     String?
  location        String?
  active          Boolean  @default(true)
  createdById     String?
  createdBy       User?    @relation("WarehouseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById     String?
  updatedBy       User?    @relation("WarehouseUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime? // soft-delete

  stockBalances   StockBalance[]
  movements       StockMovement[]
  counterpartMovements StockMovement[] @relation("StockMovementCounterpartWarehouse")

  @@index([active])
  @@index([name])
}

/**
 * Stock Balance — the cached current quantity for an InventoryItem at a
 * Warehouse. One row per (itemId, warehouseId). The authoritative source of
 * truth is the StockMovement ledger; this table is a performance cache that
 * MUST stay consistent with the ledger. All mutations go through the
 * centralized inventory-utils functions which update both atomically.
 */
model StockBalance {
  id              String   @id @default(cuid())
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  warehouseId     String
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  quantity        Decimal  @default(0) // current on-hand quantity (≥ 0 enforced by app)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // One balance row per item+warehouse (prevents duplicate balance records)
  @@unique([inventoryItemId, warehouseId])
  @@index([warehouseId])
  @@index([inventoryItemId])
}

/**
 * Stock Movement — append-only ledger of every stock-changing operation.
 * The fundamental invariant: Current Stock = Σ(in movements) − Σ(out movements).
 *
 * Movement types:
 *   RECEIPT          — goods received into stock (from a GoodsReceipt)
 *   ISSUE            — goods issued out of stock (to a project/task/employee)
 *   TRANSFER_IN      — goods received from another warehouse
 *   TRANSFER_OUT     — goods sent to another warehouse
 *   ADJUSTMENT_IN    — positive adjustment (stock count gain)
 *   ADJUSTMENT_OUT   — negative adjustment (stock count loss)
 *
 * referenceType + referenceId link the movement to its source (e.g. a
 * GoodsReceiptItem for RECEIPT, or a transfer group id for TRANSFER pairs).
 * The @@unique on (referenceType, referenceId) prevents double-posting for
 * receipt movements.
 */
model StockMovement {
  id              String   @id @default(cuid())
  movementNumber  String   @unique // SRI/ISS/TRF/ADJ-YYYY-NNNNNN
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  warehouseId     String   // warehouse where the movement occurred
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  // For transfers, the other warehouse involved (nullable for non-transfer movements)
  counterpartWarehouseId String?
  counterpartWarehouse  Warehouse? @relation("StockMovementCounterpartWarehouse", fields: [counterpartWarehouseId], references: [id], onDelete: SetNull)

  quantity        Decimal  // absolute quantity moved (always > 0)
  movementType    String   // RECEIPT | ISSUE | TRANSFER_IN | TRANSFER_OUT | ADJUSTMENT_IN | ADJUSTMENT_OUT

  // Reference to the originating record (prevents double-posting for receipts)
  referenceType   String?  // goods_receipt_item | transfer | adjustment | issue
  referenceId     String?  // the ID of the originating record

  reason          String?
  notes           String?

  // Optional project/task/employee/supplier linkage
  projectId       String?
  project         Project? @relation("StockMovementProject", fields: [projectId], references: [id], onDelete: SetNull)
  taskId          String?
  task            Task?    @relation("StockMovementTask", fields: [taskId], references: [id], onDelete: SetNull)
  supplierId      String?
  supplier        Supplier? @relation("StockMovementSupplier", fields: [supplierId], references: [id], onDelete: SetNull)
  employeeId      String?  // employee who requested an issue
  employee        Employee? @relation("StockMovementEmployeeRequester", fields: [employeeId], references: [id], onDelete: SetNull)

  performedById   String
  performedBy     User     @relation("StockMovementPerformer", fields: [performedById], references: [id], onDelete: Restrict)

  createdAt       DateTime @default(now())

  // Prevents double-posting: a given (referenceType, referenceId) can appear
  // at most once. For receipts, referenceType="goods_receipt_item" + referenceId
  // = the GoodsReceiptItem ID. A second attempt to post the same receipt item
  // violates this constraint and is rejected.
  @@unique([referenceType, referenceId])
  @@index([inventoryItemId])
  @@index([warehouseId])
  @@index([movementType])
  @@index([projectId])
  @@index([taskId])
  @@index([supplierId])
  @@index([employeeId])
  @@index([performedById])
  @@index([createdAt])
}

// ============================================================================
// PHASE 11 — ACCOUNTS PAYABLE, EXPENSES & SUPPLIER SETTLEMENT
// ----------------------------------------------------------------------------
// AP flow: SupplierBill (Dr Expense / Cr LIB-AP) → SupplierPayment (Dr LIB-AP / Cr Cash)
// Expense flow: Expense (Dr Expense / Cr Cash) — direct payment, no AP
//
// FINANCE BOUNDARY: All postings via the Finance posting engine (postJournal /
// reverseJournal). ZERO prisma.journal.create in AP code.
//
// AP RECONCILIATION: Operational AP (Σ bill.balanceDue) = Finance LIB-AP ledger.
// ============================================================================

// Concurrency-safe AP/expense reference counter.
// Prefixes: SB (supplier bill), SP (supplier payment), EXP (expense).
model PayableRefCounter {
  id        String   @id @default(cuid())
  prefix    String   // SB | SP | EXP
  year      Int
  nextNumber Int     @default(1)

  @@unique([prefix, year])
}

/**
 * SupplierBill — a supplier invoice/bill. Lifecycle:
 * draft → submitted → approved → posted → partially_paid → paid
 * Terminal: voided.
 * On POST: Dr Expense ledger / Cr LIB-AP (accrual — recognizes expense + creates AP).
 * balanceDue = total − Σ(posted supplier payments).
 */
model SupplierBill {
  id                String   @id @default(cuid())
  billNumber        String   @unique // SB-2026-000001
  supplierId        String
  supplier          Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierRef       String?  // supplier's own invoice/reference number
  projectId         String?
  project           Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  purchaseOrderId   String?  // optional link to Phase 7 PurchaseOrder
  goodsReceiptId    String?  // optional link to Phase 8 GoodsReceipt
  billDate          DateTime @default(now())
  dueDate           DateTime?
  status            String   @default("draft") // draft | submitted | approved | posted | partially_paid | paid | voided
  subtotal          Decimal  @default(0)
  tax               Decimal  @default(0)
  total             Decimal  @default(0)
  amountPaid        Decimal  @default(0) // cached: Σ posted payments
  balanceDue        Decimal  @default(0) // cached: total − amountPaid
  notes             String?
  journalId         String?  // FK to posted Journal (Dr Expense / Cr AP)
  submittedAt       DateTime?
  submittedById     String?
  approvedAt        DateTime?
  approvedById      String?
  approvedBy        User?    @relation("SupplierBillApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  postedAt          DateTime?
  voidedAt          DateTime?
  voidedById        String?
  createdById       String?
  createdBy         User?    @relation("SupplierBillCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById       String?
  updatedBy         User?    @relation("SupplierBillUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime? // soft-delete

  items             SupplierBillItem[]
  payments          SupplierPayment[]

  @@index([supplierId])
  @@index([projectId])
  @@index([status])
  @@index([billDate])
  @@index([dueDate])
}

model SupplierBillItem {
  id                String   @id @default(cuid())
  supplierBillId    String
  supplierBill      SupplierBill @relation(fields: [supplierBillId], references: [id], onDelete: Cascade)
  inventoryItemId   String?
  inventoryItem     InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  description       String
  quantity          Decimal  @default(0)
  unitPrice         Decimal  @default(0)
  total             Decimal  @default(0) // computed: quantity × unitPrice
  ledgerAccountCode String?  // expense classification (e.g. "EXP-OFFICE", "EXP-PROJ")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([supplierBillId])
  @@index([inventoryItemId])
}

/**
 * SupplierPayment — a payment to a supplier against a bill. Lifecycle:
 * draft → posted. Terminal: voided.
 * On POST: Dr LIB-AP / Cr Cash (settles AP, NO new expense).
 * On VOID: reverseJournal (Dr Cash / Cr LIB-AP — restores AP + cash).
 */
model SupplierPayment {
  id                String   @id @default(cuid())
  paymentNumber     String   @unique // SP-2026-000001
  supplierId        String
  supplier          Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierBillId    String?
  supplierBill      SupplierBill? @relation(fields: [supplierBillId], references: [id], onDelete: Restrict)
  financialAccountId String  // which cash/bank account pays
  paymentDate       DateTime @default(now())
  amount            Decimal  @default(0)
  paymentMethod     String   @default("bank_transfer") // cash | bank_transfer | mobile_money | card | cheque | other
  reference         String?  // bank slip / cheque number
  notes             String?
  status            String   @default("draft") // draft | posted | voided
  journalId         String?  // FK to posted Journal (Dr AP / Cr Cash)
  postedAt          DateTime?
  voidedAt          DateTime?
  voidedById        String?
  voidedBy          User?    @relation("SupplierPaymentVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  createdById       String?
  createdBy         User?    @relation("SupplierPaymentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([supplierId])
  @@index([supplierBillId])
  @@index([status])
  @@index([paymentDate])
}

/**
 * Expense — a direct business expense (paid immediately, no AP). Lifecycle:
 * draft → submitted → approved → posted. Terminal: voided.
 * On POST: Dr Expense ledger / Cr Cash (recognizes expense + pays immediately).
 * On VOID: reverseJournal (Dr Cash / Cr Expense — reverses both).
 */
model Expense {
  id                String   @id @default(cuid())
  expenseNumber     String   @unique // EXP-2026-000001
  ledgerAccountCode String   @default("EXP-OTHER") // expense classification (e.g. "EXP-RENT", "EXP-FUEL")
  supplierId        String?
  supplier          Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  employeeId        String?  // employee who incurred the expense
  employee          Employee? @relation("ExpenseEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  projectId         String?
  project           Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  financialAccountId String  // which cash/bank account pays
  expenseDate       DateTime @default(now())
  amount            Decimal  @default(0)
  description       String
  paymentMethod     String   @default("cash")
  reference         String?  // receipt number / reference
  notes             String?
  status            String   @default("draft") // draft | submitted | approved | posted | voided
  journalId         String?  // FK to posted Journal (Dr Expense / Cr Cash)
  submittedAt       DateTime?
  approvedAt        DateTime?
  approvedById      String?
  approvedBy        User?    @relation("ExpenseApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  postedAt          DateTime?
  voidedAt          DateTime?
  voidedById        String?
  createdById       String?
  createdBy         User?    @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([supplierId])
  @@index([employeeId])
  @@index([projectId])
  @@index([status])
  @@index([expenseDate])
  @@index([ledgerAccountCode])
}
