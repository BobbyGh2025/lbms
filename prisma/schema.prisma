// ============================================================================
// Lightworld Business Management System (LBMS) - Prisma Schema
// Phase 1: Foundation (Auth, RBAC, Org Structure, Settings, Audit, Notifications)
// ----------------------------------------------------------------------------
// NOTE: This project uses SQLite (per environment constraints). All "enum-like"
// fields are stored as String and validated at the application layer. Money
// values will be stored as Decimal in later phases once a MySQL-compatible
// datasource is available; for Phase 1 foundation tables no money fields
// are required.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================================
// AUTHENTICATION & USERS
// ============================================================================

model User {
  id                  String   @id @default(cuid())
  email               String   @unique
  username            String   @unique
  passwordHash        String
  employeeId          String?  @unique
  employee            Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  status              String   @default("active") // active | inactive | suspended
  lastLoginAt         DateTime?
  lastLoginIp         String?
  failedLoginAttempts Int      @default(0)
  lockedUntil         DateTime?
  mustChangePassword Boolean  @default(false)
  createdById         String?
  createdBy           User?    @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  usersCreated        User[]   @relation("UserCreatedBy")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?

  userRoles     UserRole[]
  auditLogs     AuditLog[]
  notifications Notification[]

  // Phase 2 finance back-relations
  finAccountsCreated  FinancialAccount[] @relation("FinAccountCreatedBy")
  ledgerAccountsCreated LedgerAccount[]  @relation("LedgerAccountCreatedBy")
  journalsCreated     Journal[]          @relation("JournalCreatedBy")
  journalsVoided     Journal[]          @relation("JournalVoidedBy")

  // Phase 3 HR back-relations
  leaveRequested  LeaveRequest[] @relation("LeaveRequestedBy")
  leaveApproved   LeaveRequest[] @relation("LeaveApprovedBy")

  @@index([status])
  @@index([createdById])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  description String?
  isSystem    Boolean  @default(false) // system roles cannot be deleted
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  permissions RolePermission[]
  users      UserRole[]
}

model Permission {
  id          String @id @default(cuid())
  module      String // e.g. "finance", "staff", "projects", "users", "settings"
  action      String // view | create | edit | delete | approve | export
  description String?

  roles RolePermission[]

  @@unique([module, action])
  @@index([module])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  assignedAt   DateTime   @default(now())
  assignedById String?

  @@id([roleId, permissionId])
}

model UserRole {
  userId      String
  roleId      String
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt  DateTime @default(now())
  assignedById String?

  @@id([userId, roleId])
}

// ============================================================================
// ORGANISATION STRUCTURE (configurable - never hard-coded)
// ============================================================================

model Department {
  id              String   @id @default(cuid())
  name            String   @unique
  code            String?  @unique
  description     String?
  headEmployeeId  String?
  headEmployee    Employee? @relation("DepartmentHead", fields: [headEmployeeId], references: [id], onDelete: SetNull)
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  employees Employee[]
  positions Position[]
  journals  Journal[] // Phase 2 finance back-relation
}

model Position {
  id              String    @id @default(cuid())
  title           String    @unique
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  description     String?
  responsibilities String?
  status          String    @default("active")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  employees Employee[]
}

model Employee {
  id              String   @id @default(cuid())
  employeeId      String   @unique // human-readable e.g. LT-EMP-0001 (legacy seed format)
  employeeNumber  String?  @unique // Phase 3 format: EMP-2026-000001 (nullable for legacy)

  // Identity
  fullName        String   // kept for backward compatibility; derived from firstName + lastName
  firstName       String?
  middleName      String?
  lastName        String?
  preferredName   String?
  profilePhotoUrl String?
  dateOfBirth     DateTime?
  gender          String?  // male | female | other

  // Contact
  phone           String?
  email           String?  @unique
  alternativePhone String?
  address         String?
  city            String?
  workLocation    String?

  // Employment
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  positionId      String?
  position        Position?   @relation(fields: [positionId], references: [id], onDelete: SetNull)
  employmentDate  DateTime?
  confirmationDate DateTime?
  endDate         DateTime?
  employmentType  String?  // full_time | part_time | contract | temporary | intern | consultant
  status          String   @default("active") // active | probation | on_leave | suspended | resigned | terminated | retired | inactive
  notes           String?

  // Reporting structure — self-relation for manager hierarchy
  managerId       String?
  manager         Employee? @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports   Employee[] @relation("EmployeeManager")
  departmentsHeaded Department[] @relation("DepartmentHead")

  // Administrative
  createdById     String?
  updatedById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  user               User?
  emergencyContacts  EmployeeEmergencyContact[]
  leaveRequests      LeaveRequest[]
  performanceReviews EmployeePerformanceReview[]

  // Phase 4 relationship back-relations
  customerAccountManager Customer[] @relation("CustomerAccountManager")
  supplierAccountManager Supplier[] @relation("SupplierAccountManager")
  activitiesAssigned    Activity[] @relation("ActivityAssignedTo")

  @@index([departmentId])
  @@index([status])
  @@index([managerId])
  @@index([employmentType])
}

// ============================================================================
// PHASE 3 — STAFF & HR MANAGEMENT
// ============================================================================

// Concurrency-safe employee number counter (separate from finance refs).
model EmployeeRefCounter {
  id        String   @id @default(cuid())
  prefix    String   @default("EMP")
  year      Int
  nextNumber Int     @default(1)

  @@unique([prefix, year])
}

model EmployeeEmergencyContact {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name        String
  relationship String?
  phone       String
  alternativePhone String?
  address     String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId])
}

// Leave types are configurable (not hard-coded enum).
model LeaveType {
  id          String   @id @default(cuid())
  name        String   @unique // e.g. Annual, Sick, Maternity, Compassionate, Study, Unpaid
  code        String   @unique // e.g. ANNUAL, SICK, MATERNITY
  description String?
  isPaid      Boolean  @default(true)
  isSystem    Boolean  @default(false) // system types seeded; cannot be deleted
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leaveRequests LeaveRequest[]
}

model LeaveRequest {
  id          String   @id @default(cuid())
  reference   String   @unique // e.g. LEV-2026-000001
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  startDate   DateTime
  endDate     DateTime
  reason      String?
  status      String   @default("pending") // pending | approved | rejected | cancelled
  attachmentUrl String?

  // Approval workflow
  requestedById   String
  requestedBy     User?    @relation("LeaveRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedById   String?
  approvedAt     DateTime?
  rejectionReason String?
  approvedBy     User? @relation("LeaveApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId])
  @@index([leaveTypeId])
  @@index([status])
  @@index([startDate])
  @@index([reference])
}

// Lightweight performance review foundation.
model EmployeePerformanceReview {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewPeriod  String   // e.g. "2026-Q1", "2026-Annual"
  reviewDate    DateTime
  reviewerId    String
  rating        String?  // e.g. "exceeds", "meets", "below" (configurable text, not hard-coded enum)
  strengths     String?
  improvementAreas String?
  objectives    String?
  comments      String?
  status        String   @default("draft") // draft | completed
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([employeeId])
  @@index([reviewDate])
}

// ============================================================================
// PHASE 4 — CUSTOMERS, SUPPLIERS & RELATIONSHIP MANAGEMENT
// ----------------------------------------------------------------------------
// Master data entities for organizations/individuals Lightworld Tech does
// business with. Customer = buys from us; Supplier = sells to us.
// Both are master data (NOT accounting entities). The Finance Journal has
// nullable partyType/partyRef string stubs from Phase 2 that will connect
// to these entities via the customerId/supplierId FKs on Journal.
// ============================================================================

// Concurrency-safe reference counter for customer/supplier numbers.
// Separate from FinanceRefCounter and EmployeeRefCounter.
model RelationshipRefCounter {
  id        String   @id @default(cuid())
  prefix    String   // CUS | SUP
  year      Int
  nextNumber Int     @default(1)

  @@unique([prefix, year])
}

model Customer {
  id              String   @id @default(cuid())
  customerNumber  String   @unique // CUS-2026-000001
  customerType    String   @default("business") // individual | business | organization | government | ngo | other
  legalName       String?
  tradingName     String?  // display name (may differ from legal name)
  firstName       String?  // for individual type
  lastName        String?  // for individual type
  email           String?
  phone           String?
  alternativePhone String?
  website         String?
  address         String?
  city            String?
  region          String?
  country         String   @default("Ghana")
  industry        String?
  contactPerson   String?  // primary contact name (quick reference)
  accountManagerId String? // Employee FK
  accountManager  Employee? @relation("CustomerAccountManager", fields: [accountManagerId], references: [id], onDelete: SetNull)
  status          String   @default("active") // active | inactive | prospect | suspended | archived
  customerSince   DateTime?
  notes           String?
  createdById     String?
  updatedById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime? // soft-delete (archive)

  contacts   CustomerContact[]
  activities Activity[] @relation("ActivityCustomer")
  journals   Journal[]  @relation("JournalCustomer")

  @@index([status])
  @@index([customerType])
  @@index([accountManagerId])
  @@index([tradingName])
}

model CustomerContact {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String?
  jobTitle    String?
  email       String?
  phone       String?
  alternativePhone String?
  preferredContactMethod String? // email | phone | sms | other
  isPrimary   Boolean  @default(false)
  notes       String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([customerId])
}

model Supplier {
  id              String   @id @default(cuid())
  supplierNumber  String   @unique // SUP-2026-000001
  supplierType    String   @default("business") // business | individual | contractor | service_provider | government | other
  legalName       String?
  tradingName     String?
  email           String?
  phone           String?
  alternativePhone String?
  website         String?
  address         String?
  city            String?
  region          String?
  country         String   @default("Ghana")
  industry        String?  // category of goods/services
  contactPerson   String?
  accountManagerId String?
  accountManager  Employee? @relation("SupplierAccountManager", fields: [accountManagerId], references: [id], onDelete: SetNull)
  status          String   @default("active") // active | inactive | suspended | archived
  supplierSince   DateTime?
  notes           String?
  createdById     String?
  updatedById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  contacts   SupplierContact[]
  activities Activity[] @relation("ActivitySupplier")
  journals   Journal[]  @relation("JournalSupplier")

  @@index([status])
  @@index([supplierType])
  @@index([accountManagerId])
  @@index([tradingName])
}

model SupplierContact {
  id          String   @id @default(cuid())
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String?
  jobTitle    String?
  email       String?
  phone       String?
  alternativePhone String?
  preferredContactMethod String?
  isPrimary   Boolean  @default(false)
  notes       String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([supplierId])
}

// Lightweight CRM activity / follow-up foundation.
model Activity {
  id          String   @id @default(cuid())
  activityType String  // call | meeting | email | follow_up | site_visit | note | quotation | other
  subject     String
  description String?
  customerId  String?
  customer    Customer? @relation("ActivityCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  supplierId  String?
  supplier    Supplier? @relation("ActivitySupplier", fields: [supplierId], references: [id], onDelete: SetNull)
  assignedToId String?  // Employee FK
  assignedTo  Employee? @relation("ActivityAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  dueDate     DateTime?
  completedDate DateTime?
  status      String   @default("open") // open | completed | cancelled | overdue
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([customerId])
  @@index([supplierId])
  @@index([assignedToId])
  @@index([status])
  @@index([dueDate])
}

// ============================================================================
// COMPANY SETTINGS (single-row configuration table)
// ============================================================================

model CompanySetting {
  id                  String   @id @default("singleton")
  companyName         String   @default("Lightworld Tech")
  legalName           String?
  logoUrl             String?
  address             String?
  city                String?
  region              String?
  country             String   @default("Ghana")
  phone               String?
  email               String?
  website             String?
  currency            String   @default("GHS")
  currencySymbol      String   @default("GH\u20B5")
  financialYearStart  String?  // e.g. "01-01" (MM-DD)
  invoicePrefix       String   @default("INV-")
  invoiceStart        Int      @default(1)
  taxIdNumber         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ============================================================================
// AUDIT TRAIL (immutable record of important actions)
// ============================================================================

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action        String   // login | logout | create | update | delete | approve | reject | view_sensitive
  module        String   // auth | users | roles | settings | departments | positions | employees
  recordId      String?
  recordType    String?
  description   String?
  ipAddress     String?
  userAgent     String?
  previousValue String?  // JSON string of previous state
  newValue      String?  // JSON string of new state
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([module])
  @@index([createdAt])
}

// ============================================================================
// NOTIFICATIONS & REMINDERS
// ============================================================================

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String    @default("info") // info | warning | error | success
  category  String?   // approval | task | invoice | payment | deadline | system | etc
  linkUrl   String?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

// ============================================================================
// PHASE 2 — FINANCE FOUNDATION
// ----------------------------------------------------------------------------
// Journal/ledger double-entry architecture. Money uses Prisma `Decimal`
// (stored as TEXT in SQLite for dev; migrates to DECIMAL(18,2) on
// PostgreSQL/MySQL with zero schema change). Balances are DERIVED from
// posted JournalEntries — there is no mutable `currentBalance` field.
//
//   FinancialAccount  (where money lives: cash/bank/momo)
//          ↓
//   LedgerAccount      (chart of accounts: income/expense/asset categories)
//          ↓
//   Journal            (one financial event; header)
//          ↓
//   JournalEntry       (debit/credit lines; MUST balance: Σ debit = Σ credit)
//          ↓
//   Reporting Service  (single source of truth for balances/summaries)
//          ↓
//   Dashboard / Reports / Exports
// ============================================================================

// Account types classify the nature of a financial account.
//   asset      — cash, bank, mobile money (debit-normal: debits increase)
//   liability  — payables, loans (credit-normal: credits increase)
//   equity     — owner's equity, retained earnings (credit-normal)
//   income     — revenue categories (credit-normal)
//   expense    — expense categories (debit-normal)

model FinancialAccount {
  id            String   @id @default(cuid())
  code          String   @unique // e.g. "CASH-001", "BANK-001"
  name          String   @unique
  accountType   String   @default("asset") // asset | liability (financial accounts are typically asset accounts that hold money)
  currency      String   @default("GHS")
  // Opening balance is posted via an OPENING_BALANCE journal — NOT a mutable
  // live field. `openingBalance` is the seed value used to generate that
  // journal at account creation. It is never updated by transactions.
  openingBalance Decimal @default(0)
  status        String   @default("active") // active | inactive
  description   String?
  bankName      String?
  accountNumber String?  // masked/reference only
  createdById   String?
  createdBy     User?    @relation("FinAccountCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  journalEntries JournalEntry[]
  journals       Journal[] // journals where this is the primary financial account

  @@index([status])
  @@index([currency])
}

// Chart of accounts — categorizes the nature of money movement.
// One LedgerAccount per income/expense/asset/liability/equity category.
model LedgerAccount {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. "INC-SALES", "EXP-FUEL"
  name        String   @unique
  accountClass String  // asset | liability | equity | income | expense
  accountType String   // e.g. "income", "expense", "asset", "liability", "equity"
  currency    String   @default("GHS")
  status      String   @default("active")
  description String?
  isSystem    Boolean  @default(false) // system categories seeded; can be deactivated but not deleted
  createdById String?
  createdBy   User?    @relation("LedgerAccountCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  journals      Journal[]
  journalEntries JournalEntry[]

  @@index([accountClass])
  @@index([accountType])
  @@index([status])
}

// A Journal is ONE financial event (an income receipt, an expense payment,
// a transfer, an opening balance, or an adjustment). It owns ≥2 JournalEntry
// lines that must balance: Σ(debit) = Σ(credit).
model Journal {
  id              String   @id @default(cuid())
  reference       String   @unique // e.g. "INC-2026-000001" — concurrency-safe, generated in-transaction
  transactionType String   // income | expense | transfer | opening_balance | adjustment
  status          String   @default("posted") // draft | posted | voided | reversed
  transactionDate DateTime // the accounting date (NOT createdAt — may differ)
  description     String?
  notes           String?

  // The financial account primarily affected (receiving account for income,
  // paying account for expense, source for transfer). For multi-account
  // journals (transfers), the full debit/credit breakdown is in JournalEntry.
  financialAccountId String?
  financialAccount   FinancialAccount? @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)

  // The primary ledger category (income/expense category). Full breakdown
  // is in JournalEntry.
  ledgerAccountId String?
  ledgerAccount   LedgerAccount? @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)

  // Optional relations — wired to Phase 5/6 entities when they land.
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  // Party reference (customer/supplier) — nullable stub from Phase 2.
  // `partyType` discriminates; `partyRef` holds the entity ID as a string.
  // Phase 4 adds proper FK relations (customerId/supplierId) below.
  partyType String? // customer | supplier | null
  partyRef  String? // future FK to Customer/Supplier

  // Phase 4: proper Customer/Supplier FK relations (nullable, alongside the
  // string stubs for backward compatibility with existing journals).
  customerId String?
  customer   Customer? @relation("JournalCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  supplierId String?
  supplier   Supplier? @relation("JournalSupplier", fields: [supplierId], references: [id], onDelete: SetNull)

  // Project reference — nullable stub for Phase 6.
  projectRef String?

  paymentMethod String? // cash | bank_transfer | mobile_money | card | cheque | other
  externalRef  String? // bank slip / cheque / momo transaction id

  // Reversal linkage. `reversesId` is the FK on the reversal journal pointing
  // to the original. `reverses` is the relation (holds fields). `reversedBy`
  // is the inverse relation on the original journal (no fields).
  reversesId      String?  @unique
  reverses        Journal?  @relation("JournalReversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversedBy     Journal?  @relation("JournalReversal")
  reversalReason String?

  // Total monetary value of the transaction (the absolute amount; equals
  // Σ(debit) = Σ(credit)). Stored as Decimal for exact precision.
  amount      Decimal
  currency    String  @default("GHS")

  createdById String
  createdBy   User    @relation("JournalCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  postedAt    DateTime?
  voidedAt    DateTime?
  voidedById  String?
  voidedBy    User?   @relation("JournalVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entries JournalEntry[]

  @@index([transactionType])
  @@index([status])
  @@index([transactionDate])
  @@index([financialAccountId])
  @@index([ledgerAccountId])
  @@index([departmentId])
  @@index([createdById])
  @@index([reference])
  @@index([customerId])
  @@index([supplierId])
}

// A single debit OR credit line within a Journal. Exactly one of
// (debit, credit) is non-zero per entry. The journal is balanced when
// Σ(debit) = Σ(credit) across all its entries.
//
// `financialAccountId` is OPTIONAL: only entries that move money in/out of
// a cash/bank/momo account reference a FinancialAccount. The counter-side
// (e.g. an income category credit, or an expense category debit) references
// only a LedgerAccount. This mirrors real accounting where income/expense
// categories are not "accounts you hold money in".
model JournalEntry {
  id                String   @id @default(cuid())
  journalId         String
  journal           Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)

  financialAccountId String?
  financialAccount   FinancialAccount? @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)

  ledgerAccountId   String?
  ledgerAccount     LedgerAccount? @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)

  // Exactly one of debit/credit is non-zero (the other is 0). Both Decimal.
  debit  Decimal @default(0)
  credit Decimal @default(0)
  currency String @default("GHS")

  description String?
  createdAt   DateTime @default(now())

  @@index([journalId])
  @@index([financialAccountId])
  @@index([ledgerAccountId])
}

// Concurrency-safe reference counter. Each (prefix, year) gets a row;
// the posting engine increments `nextNumber` inside a db.$transaction
// to guarantee uniqueness even under concurrent inserts.
model FinanceRefCounter {
  id        String   @id @default(cuid())
  prefix    String   // INC | EXP | TRF | OPB | ADJ
  year      Int
  nextNumber Int     @default(1)

  @@unique([prefix, year])
}

// Idempotency log — optional. If a client sends an `Idempotency-Key`
// header, the server records the request; a replay returns the cached
// response instead of creating a duplicate transaction.
model FinanceIdempotencyLog {
  id            String   @id @default(cuid())
  key           String   @unique
  userId        String
  responseHash  String
  responseBody  String
  statusCode    Int
  createdAt     DateTime @default(now())
  expiresAt     DateTime

