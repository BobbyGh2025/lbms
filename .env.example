# LBMS Environment Configuration Template
# ----------------------------------------------------------------------------
# Copy to .env and fill with REAL values for your environment.
# NEVER commit real secrets to version control.

# === DATABASE (REQUIRED) ===
# PostgreSQL connection string (production/staging).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# For local dev with SQLite: file:./db/custom.db
DATABASE_URL="postgresql://user:password@localhost:5432/lbms?schema=public"

# === AUTHENTICATION (REQUIRED) ===
# Generate a strong random secret (>= 32 chars): openssl rand -base64 48
NEXTAUTH_SECRET="generate-a-strong-random-secret-at-least-32-chars"

# The canonical URL users access the application from (HTTPS in production).
NEXTAUTH_URL="https://your-production-domain.com"
